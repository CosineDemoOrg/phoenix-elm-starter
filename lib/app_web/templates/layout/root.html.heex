<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <%= csrf_meta_tag() %>
    <.live_title suffix=" · Phoenix Framework">
      <%= assigns[:page_title] || "Elm Starter" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
   
  </head>
  <body>
    <header>
      <section class="container">
        <nav>
          <ul>
            <li><a href="https://hexdocs.pm/phoenix/overview.html">Get Started</a></li>
            <li><%= live_redirect "Dashboard", to: Routes.live_path(@conn, AppWeb.DashboardLive) %></li>
            <%= if @conn.assigns[:current_user] do %>
              <li>Signed in as <%= @conn.assigns.current_user.email %></li>
              <li><%= link "Sign out", to: Routes.pow_session_path(@conn, :delete), method: :delete %></li>
            <% else %>
              <li><%= link "Sign in", to: Routes.pow_session_path(@conn, :new) %></li>
              <%= if Application.get_env(:app, :pow_assent, [])[:providers] |> Enum.any?() do %>
                <li><%= link "Sign in with GitHub", to: Routes.pow_assent_authorization_path(@conn, :new, :github) %></li>
                <li><%= link "Sign in with Google", to: Routes.pow_assent_authorization_path(@conn, :new, :google) %></li>
              <% end %>
            <% end %>
          </ul>
        </nav>
        <a href="https://phoenixframework.org/" class="phx-logo">
          <img src={Routes.static_path(@conn, "/images/phoenix.png")} alt="Phoenix Framework Logo"/>
        </a>
      </section>
    </header>
    <%= @inner_content %>

    <div id="elm-app"></div>
    <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/elm.js")}></script>
  </body>
</html>
